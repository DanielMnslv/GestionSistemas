# Copia este archivo como .env en la carpeta jano_inventario del servidor
# y completa los valores. NO lo compartas: lleva claves.

DJANGO_DEBUG=False
# Clave larga y aleatoria. Generarla con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

DJANGO_ALLOWED_HOSTS=gestionsistemas.seguridadjano.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://gestionsistemas.seguridadjano.com
# Plesk ya da HTTPS: Django no redirige por su cuenta.
DJANGO_HTTPS=True
DJANGO_SECURE_SSL_REDIRECT=False

DJANGO_SITIO_URL=https://gestionsistemas.seguridadjano.com
DJANGO_SITIO_URL_PUBLICO=https://gestionsistemas.seguridadjano.com

# Base de datos: el archivo db.sqlite3 que viene en el paquete.
# DJANGO_DB_PATH=/ruta/completa/jano_inventario/db.sqlite3

# Correo (enlaces de contraseña y avisos de los casos)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Agenda de visitas
SOPORTE_CUPOS_FRANJA=3
SOPORTE_DIAS_AGENDA=10
